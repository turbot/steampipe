{
  "warm": "git submodule update --init --recursive && go mod download",
  "warmProbe": "tests/acceptance/lib/bats-core/bin/bats",
  "platforms": [
    "darwin",
    "linux"
  ],
  "tools": [
    "go",
    "jq",
    "jd",
    "psql"
  ],
  "secrets": {},
  "releasePr": { "workflow": "release.yml", "base": "main" },
  "chores": {
    "security-audit": {
      "when": "mon week 3",
      "areas": [
        "plugin and database image downloads (pkg/ociinstaller)",
        "embedded Postgres setup, passwords and SSL (pkg/db/db_local)",
        "Pipes login and token handling (cmd/login.go)",
        "connection config loading (pkg/steampipeconfig)",
        "plugin manager gRPC service (pkg/pluginmanager_service)"
      ],
      "off": true
    },
    "secret-scan": {
      "off": true
    },
    "dependabot-cant-fix": {
      "off": true
    }
  }
}
